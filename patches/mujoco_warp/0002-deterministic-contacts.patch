+"""Dense constraint layout and contact row mapping regression."""
+
+import mujoco
+import numpy as np
+import warp as wp
+
+import mujoco_warp as mjw
+from mujoco_warp import test_data
+from mujoco_warp._src import constraint
+from mujoco_warp._src import constraint_order
+from mujoco_warp._src.types import ConstraintType
+
+
+def test_canonical_block_rows_and_contact_mapping():
+  _, _, _, d = test_data.fixture(
+    xml='<mujoco><worldbody><body><freejoint/><geom type="sphere" size=".1"/></body></worldbody></mujoco>',
+    nworld=2,
+    nconmax=8,
+    njmax=17,
+  )
+  # Equality components must remain together; friction/limits precede contacts.
+  kinds = [ConstraintType.EQUALITY] * 3 + [ConstraintType.FRICTION_DOF] * 2 + [ConstraintType.LIMIT_JOINT] * 2
+  kinds += [ConstraintType.CONTACT_ELLIPTIC] * 6
+  base = {}
+  for field in constraint_order._FIELDS + ("J",):
+    value = getattr(d.efc, field).numpy()
+    value[:] = np.arange(value.size, dtype=value.dtype).reshape(value.shape)
+    base[field] = value
+  for world in range(d.nworld):
+    base["type"][world, :13] = kinds
+    base["id"][world, :13] = [5, 5, 5, 0, 1, 0, 1] + [2 * world] * 3 + [2 * world + 1] * 3
+  wp.copy(d.nefc, wp.array([13, 13], dtype=int))
+  d.nacon.fill_(4)
+  worlds = np.full(d.naconmax, -1, dtype=np.int32)
+  worlds[:4] = [0, 0, 1, 1]
+  wp.copy(d.contact.worldid, wp.array(worlds, dtype=int))
+
+  def canonicalize():
+    constraint_order.order_constraints_dense(d)
+
+  if wp.get_device().is_cuda and not wp.config.verify_cuda:
+    with wp.ScopedCapture() as capture:
+      canonicalize()
+    run = lambda: wp.capture_launch(capture.graph)
+  else:
+    run = canonicalize
+  blocks = [np.arange(3), np.array([3]), np.array([4]), np.array([5]), np.array([6]), np.arange(7, 10), np.arange(10, 13)]
+  rng = np.random.default_rng(72)
+  for _ in range(20):
+    orders = [np.concatenate([blocks[i] for i in rng.permutation(len(blocks))]) for _ in range(d.nworld)]
+    for field, value in base.items():
+      permuted = value.copy()
+      for world, order in enumerate(orders):
+        permuted[world, :13] = value[world, order]
+      wp.copy(getattr(d.efc, field), wp.array(permuted, dtype=getattr(d.efc, field).dtype))
+    addresses = np.full(d.contact.efc_address.shape, -1, dtype=np.int32)
+    expected = addresses.copy()
+    for world, order in enumerate(orders):
+      inverse = np.argsort(order)
+      for local in range(2):
+        rows = np.arange(7 + local * 3, 10 + local * 3)
+        addresses[2 * world + local, :3] = inverse[rows]
+        expected[2 * world + local, :3] = rows
+    wp.copy(d.contact.efc_address, wp.array(addresses, dtype=int))
+    run()
+    for field, value in base.items():
+      np.testing.assert_array_equal(getattr(d.efc, field).numpy().view(np.uint8), value.view(np.uint8))
+    np.testing.assert_array_equal(d.contact.efc_address.numpy(), expected)
+
+  # Empty counts preserve inactive/padded storage and negative contact addresses.
+  d.nefc.zero_()
+  d.nacon.zero_()
+  run()
+  for field, value in base.items():
+    np.testing.assert_array_equal(getattr(d.efc, field).numpy(), value)
+
+
+def test_dense_constraint_generation_preserves_values():
+  mjm, mjd, m, _ = test_data.fixture(
+    xml="""<mujoco>
+      <option cone="elliptic" jacobian="dense"/>
+      <worldbody>
+        <geom type="plane" size="5 5 .1"/>
+        <body name="a" pos="-.2 0 .02"><freejoint/><geom type="box" size=".05 .05 .03" condim="6"/></body>
+        <body name="b" pos=".2 0 .02"><freejoint/><geom type="box" size=".05 .05 .03" condim="6"/></body>
+        <body pos="0 0 1"><joint type="slide" limited="true" range="-.1 .1" frictionloss=".1"/>
+          <geom type="sphere" size=".05"/></body>
+      </worldbody>
+      <equality><connect body1="a" body2="b" anchor="0 0 0"/></equality>
+    </mujoco>""",
+  )
+  mjd.qpos[-1] = 0.2
+  mjd.qvel[0] = 0.5
+  mujoco.mj_forward(mjm, mjd)
+  d = mjw.put_data(mjm, mjd, nworld=4, nconmax=32, njmax=128)
+  m.opt.deterministic_contacts = True
+  mjw.collision(m, d)
+  m.opt.deterministic_contacts = False
+  constraint.make_constraint(m, d)
+  counts = d.nefc.numpy()
+  kinds, identities = d.efc.type.numpy(), d.efc.id.numpy()
+  expected = {}
+  for field in ("type", "id", "J", "pos", "margin", "D", "vel", "aref", "frictionloss", "Jqvel"):
+    values = getattr(d.efc, field).numpy()
+    expected[field] = [
+      values[w, np.lexsort((np.arange(n), identities[w, :n], kinds[w, :n]))].copy() for w, n in enumerate(counts)
+    ]
+  assert {
+    ConstraintType.EQUALITY,
+    ConstraintType.FRICTION_DOF,
+    ConstraintType.LIMIT_JOINT,
+    ConstraintType.CONTACT_ELLIPTIC,
+  } <= set(kinds[0, : counts[0]])
+  m.opt.deterministic_contacts = True
+  for _ in range(10):
+    constraint.make_constraint(m, d)
+    np.testing.assert_array_equal(d.nefc.numpy(), counts)
+    for field, rows in expected.items():
+      actual = getattr(d.efc, field).numpy()
+      for world, row in enumerate(rows):
+        np.testing.assert_array_equal(actual[world, : counts[world]].view(np.uint8), row.view(np.uint8))
