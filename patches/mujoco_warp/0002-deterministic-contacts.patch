+
+"""Canonical dense constraint rows after temporary atomic allocation."""
+
+import warp as wp
+
+wp.set_module_options({"enable_backward": False})
+
+
+@wp.struct
+class RowBuffer:
+  type: wp.array2d[int]
+  id: wp.array2d[int]
+  pos: wp.array2d[float]
+  margin: wp.array2d[float]
+  D: wp.array2d[float]
+  vel: wp.array2d[float]
+  aref: wp.array2d[float]
+  frictionloss: wp.array2d[float]
+  force: wp.array2d[float]
+  state: wp.array2d[int]
+  island: wp.array2d[int]
+  Jqvel: wp.array2d[float]
+
+
+_FIELDS = ("type", "id", "pos", "margin", "D", "vel", "aref", "frictionloss", "force", "state", "island", "Jqvel")
+
+
+@wp.kernel
+def _row_order(
+  # Data in:
+  nefc_in: wp.array[int],
+  efc_type_in: wp.array2d[int],
+  efc_id_in: wp.array2d[int],
+  # Out:
+  order_out: wp.array2d[int],
+  inverse_out: wp.array2d[int],
+):
+  world, row = wp.tid()
+  count = wp.min(nefc_in[world], efc_type_in.shape[1])
+  if row >= count:
+    order_out[world, row] = row
+    inverse_out[world, row] = row
+    return
+  kind = efc_type_in[world, row]
+  identity = efc_id_in[world, row]
+  rank = int(0)
+  # Every constraint block is allocated contiguously. Stable ties preserve
+  # its intrinsic component order; type/id order is independent of scheduling.
+  for other in range(count):
+    other_kind = efc_type_in[world, other]
+    other_id = efc_id_in[world, other]
+    if other_kind < kind or (other_kind == kind and (other_id < identity or (other_id == identity and other < row))):
+      rank += 1
+  order_out[world, rank] = row
+  inverse_out[world, row] = rank
+
+
+@wp.kernel
+def _gather_rows(
+  # In:
+  source: RowBuffer,
+  order: wp.array2d[int],
+  # Out:
+  target: RowBuffer,
+):
+  world, row = wp.tid()
+  old = order[world, row]
+  # Copy padding too: tile loads may read it before applying an inactive mask.
+  target.D[world, row] = source.D[world, old]
+  target.state[world, row] = source.state[world, old]
+  if row < source.type.shape[1]:
+    target.type[world, row] = source.type[world, old]
+    target.id[world, row] = source.id[world, old]
+    target.pos[world, row] = source.pos[world, old]
+    target.margin[world, row] = source.margin[world, old]
+    target.vel[world, row] = source.vel[world, old]
+    target.aref[world, row] = source.aref[world, old]
+    target.frictionloss[world, row] = source.frictionloss[world, old]
+    target.force[world, row] = source.force[world, old]
+    target.island[world, row] = source.island[world, old]
+    target.Jqvel[world, row] = source.Jqvel[world, old]
+
+
+@wp.kernel
+def _gather_jacobian(
+  # In:
+  source: wp.array3d[float],
+  order: wp.array2d[int],
+  # Out:
+  jacobian_out: wp.array3d[float],
+):
+  world, row, dof = wp.tid()
+  jacobian_out[world, row, dof] = source[world, order[world, row], dof]
+
+
+@wp.kernel
+def _remap_contacts(
+  # Data in:
+  contact_worldid_in: wp.array[int],
+  nacon_in: wp.array[int],
+  # In:
+  inverse: wp.array2d[int],
+  # Data out:
+  contact_efc_address_out: wp.array2d[int],
+):
+  contact, component = wp.tid()
+  if contact >= nacon_in[0]:
+    return
+  old = contact_efc_address_out[contact, component]
+  if old >= 0 and old < inverse.shape[1]:
+    contact_efc_address_out[contact, component] = inverse[contact_worldid_in[contact], old]
+
+
+def order_constraints_dense(data):
+  """Fix dense row layout without changing arithmetic or dropping inactive padding.
+
+  Equality/friction/limit/contact categories keep their required relative order.
+  Contact identities must already be canonical. Overflow invalidates reproducibility.
+  Sparse Jacobian storage and its block metadata are not handled here.
+  """
+  if not data.njmax:
+    return
+  source, target = RowBuffer(), RowBuffer()
+  for field in _FIELDS:
+    setattr(source, field, getattr(data.efc, field))
+    setattr(target, field, wp.empty_like(getattr(data.efc, field)))
+  order = wp.empty(source.D.shape, dtype=int)
+  inverse = wp.empty(source.D.shape, dtype=int)
+  jacobian = wp.empty_like(data.efc.J)
+  wp.launch(_row_order, dim=order.shape, inputs=[data.nefc, source.type, source.id], outputs=[order, inverse])
+  wp.launch(_gather_rows, dim=order.shape, inputs=[source, order], outputs=[target])
+  wp.launch(_gather_jacobian, dim=data.efc.J.shape, inputs=[data.efc.J, order], outputs=[jacobian])
+  wp.launch(
+    _remap_contacts,
+    dim=data.contact.efc_address.shape,
+    inputs=[data.contact.worldid, data.nacon, inverse],
+    outputs=[data.contact.efc_address],
+  )
+  for field in _FIELDS:
+    wp.copy(getattr(data.efc, field), getattr(target, field))
+  wp.copy(data.efc.J, jacobian)
