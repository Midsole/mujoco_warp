+
+"""Deterministic contact compaction and ordering without floating-point reductions."""
+
+import dataclasses
+
+import warp as wp
+
+from mujoco_warp._src.types import vec5
+
+wp.set_module_options({"enable_backward": False, "default_grid_stride": False})
+
+
+@wp.struct
+class ContactBuffer:
+  dist: wp.array[float]
+  pos: wp.array[wp.vec3]
+  frame: wp.array[wp.mat33]
+  includemargin: wp.array[float]
+  friction: wp.array[vec5]
+  solref: wp.array[wp.vec2]
+  solreffriction: wp.array[wp.vec2]
+  solimp: wp.array[vec5]
+  dim: wp.array[int]
+  geom: wp.array[wp.vec2i]
+  flex: wp.array[wp.vec2i]
+  elem: wp.array[wp.vec2i]
+  vert: wp.array[wp.vec2i]
+  efc_address: wp.array2d[int]
+  worldid: wp.array[int]
+  type: wp.array[int]
+  geomcollisionid: wp.array[int]
+  adhesion: wp.array[float]
+
+
+def contact_buffer(contact):
+  """Wrap the complete contact record; sorting must move every field together."""
+  buffer = ContactBuffer()
+  for field in dataclasses.fields(contact):
+    setattr(buffer, field.name, getattr(contact, field.name))
+  return buffer
+
+
+def empty_contact_buffer(contact, capacity):
+  """Allocate scratch records with the same dtypes and constraint address width."""
+  buffer = ContactBuffer()
+  for field in dataclasses.fields(contact):
+    array = getattr(contact, field.name)
+    shape = (capacity if array.size else 0, *array.shape[1:])
+    setattr(buffer, field.name, wp.empty(shape, dtype=array.dtype))
+  return buffer
+
+
+@wp.func
+def copy_contact(source: ContactBuffer, target: ContactBuffer, src: int, dst: int):
+  target.dist[dst] = source.dist[src]
+  target.pos[dst] = source.pos[src]
+  target.frame[dst] = source.frame[src]
+  target.includemargin[dst] = source.includemargin[src]
+  target.friction[dst] = source.friction[src]
+  target.solref[dst] = source.solref[src]
+  target.solreffriction[dst] = source.solreffriction[src]
+  target.solimp[dst] = source.solimp[src]
+  target.dim[dst] = source.dim[src]
+  target.geom[dst] = source.geom[src]
+  if source.flex.shape[0]:
+    target.flex[dst] = source.flex[src]
+    target.elem[dst] = source.elem[src]
+    target.vert[dst] = source.vert[src]
+  target.worldid[dst] = source.worldid[src]
+  target.type[dst] = source.type[src]
+  target.geomcollisionid[dst] = source.geomcollisionid[src]
+  target.adhesion[dst] = source.adhesion[src]
+  for dim in range(source.efc_address.shape[1]):
+    target.efc_address[dst, dim] = source.efc_address[src, dim]
+
+
+@wp.func
+def integer_key(contact: ContactBuffer, index: int, component: int) -> int:
+  if component < 2:
+    return contact.geom[index][component]
+  if component < 4:
+    if contact.flex.shape[0]:
+      return contact.flex[index][component - 2]
+    return -1
+  if component < 6:
+    if contact.elem.shape[0]:
+      return contact.elem[index][component - 4]
+    return -1
+  if component < 8:
+    if contact.vert.shape[0]:
+      return contact.vert[index][component - 6]
+    return -1
+  if component == 8:
+    return contact.geomcollisionid[index]
+  if component == 9:
+    return contact.dim[index]
+  return contact.type[index]
+
+
+@wp.func
+def float_key(contact: ContactBuffer, index: int, component: int) -> float:
+  if component == 0:
+    return contact.dist[index]
+  if component < 4:
+    return contact.pos[index][component - 1]
+  if component < 13:
+    offset = component - 4
+    return contact.frame[index][offset // 3, offset % 3]
+  if component == 13:
+    return contact.includemargin[index]
+  if component < 19:
+    return contact.friction[index][component - 14]
+  if component < 21:
+    return contact.solref[index][component - 19]
+  if component < 23:
+    return contact.solreffriction[index][component - 21]
+  if component < 28:
+    return contact.solimp[index][component - 23]
+  return contact.adhesion[index]
+
+
+@wp.func
+def contact_less(contact: ContactBuffer, a: int, b: int) -> bool:
+  for component in range(11):
+    ka = integer_key(contact, a, component)
+    kb = integer_key(contact, b, component)
+    if ka != kb:
+      return ka < kb
+  for component in range(29):
+    fa = float_key(contact, a, component)
+    fb = float_key(contact, b, component)
+    if wp.isnan(fa) != wp.isnan(fb):
+      return not wp.isnan(fa)
+    if not wp.isnan(fa):
+      if fa != fb:
+        return fa < fb
+      if fa == 0.0 and wp.copysign(1.0, fa) != wp.copysign(1.0, fb):
+        return wp.copysign(1.0, fa) < wp.copysign(1.0, fb)
+  # Equal physical records are interchangeable; this only makes their ranks unique.
+  return a < b
+
+
+@wp.kernel
+def _world_keys(count: wp.array[int], contact: ContactBuffer, keys_out: wp.array[int], indices_out: wp.array[int]):
+  index = wp.tid()
+  key = int(2147483647)
+  if index < count[0]:
+    key = contact.worldid[index]
+  keys_out[index] = key
+  indices_out[index] = index
+
+
+@wp.kernel
+def _contact_ranks(
+  count: wp.array[int], contact: ContactBuffer, keys: wp.array[int], indices: wp.array[int], order_out: wp.array[int]
+):
+  index = wp.tid()
+  limit = wp.min(count[0], contact.worldid.shape[0])
+  if index >= limit:
+    return
+  world = keys[index]
+  lower = int(0)
+  upper = index
+  while lower < upper:
+    mid = (lower + upper) // 2
+    if keys[mid] < world:
+      lower = mid + 1
+    else:
+      upper = mid
+  first = lower
+  lower = index + 1
+  upper = limit
+  while lower < upper:
+    mid = (lower + upper) // 2
+    if keys[mid] <= world:
+      lower = mid + 1
+    else:
+      upper = mid
+  last = lower
+  source = indices[index]
+  rank = first
+  for other in range(first, last):
+    if contact_less(contact, indices[other], source):
+      rank += 1
+  order_out[rank] = source
+
+
+@wp.kernel
+def _gather(count: wp.array[int], source: ContactBuffer, target: ContactBuffer, order: wp.array[int]):
+  index = wp.tid()
+  if index < count[0]:
+    copy_contact(source, target, order[index], index)
+
+
+def order_contacts(data):
+  """Canonically order finite contacts by world and complete physical record on the GPU.
+
+  This fixes emission order, not solver reductions. Overflow still invalidates reproducibility.
+  Ranking is quadratic in each world's contact count, rather than in the whole batch size.
+  """
+  capacity = data.naconmax
+  if not capacity:
+    return
+  source = contact_buffer(data.contact)
+  scratch = empty_contact_buffer(data.contact, capacity)
+  keys = wp.empty(2 * capacity, dtype=int)
+  indices = wp.empty(2 * capacity, dtype=int)
+  order = wp.empty(capacity, dtype=int)
+  wp.launch(_world_keys, dim=capacity, inputs=[data.nacon, source], outputs=[keys, indices])
+  wp.utils.radix_sort_pairs(keys, indices, capacity)
+  wp.launch(_contact_ranks, dim=capacity, inputs=[data.nacon, source, keys, indices], outputs=[order])
+  wp.launch(_gather, dim=capacity, inputs=[data.nacon, source, scratch, order])
+  for field in dataclasses.fields(data.contact):
+    if getattr(data.contact, field.name).size:
+      wp.copy(getattr(data.contact, field.name), getattr(scratch, field.name))
+
+
+@wp.kernel
+def _valid_slots(worldid: wp.array[int], valid_out: wp.array[int]):
+  index = wp.tid()
+  valid_out[index] = int(worldid[index] >= 0)
+
+
+@wp.kernel
+def _compact_slots(source: ContactBuffer, target: ContactBuffer, prefix: wp.array[int], count: wp.array[int]):
+  index = wp.tid()
+  if source.worldid[index] < 0:
+    return
+  destination = count[0] + prefix[index] - 1
+  if destination < target.worldid.shape[0]:
+    copy_contact(source, target, index, destination)
+
+
+@wp.kernel
+def _append_count(prefix: wp.array[int], count_out: wp.array[int]):
+  count_out[0] = count_out[0] + prefix[prefix.shape[0] - 1]
+
+
+def append_slots(source, data):
+  """Compact fixed SDF slots with an integer prefix scan, preserving overflow counts."""
+  capacity = source.worldid.shape[0]
+  valid = wp.empty(capacity, dtype=int)
+  prefix = wp.empty(capacity, dtype=int)
+  wp.launch(_valid_slots, dim=capacity, inputs=[source.worldid], outputs=[valid])
+  wp.utils.array_scan(valid, prefix)
+  wp.launch(_compact_slots, dim=capacity, inputs=[source, contact_buffer(data.contact), prefix, data.nacon])
+  wp.launch(_append_count, dim=1, inputs=[prefix, data.nacon])
